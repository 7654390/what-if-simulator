{
  "name": "what-if-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic Monte Carlo engine for personal finance scenarios",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./worker": "./dist/worker.js"
  },
  "files": [
    "dist",
    "README.md",
    "ASSUMPTIONS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:built": "node --test test/built.test.mjs",
    "bench": "vitest bench --run",
    "bench:worker": "node test/worker-benchmark.mjs",
    "demo": "tsx cli/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
